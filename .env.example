PORT=3000
DB_PATH=./data/hotel.db
AUTH_SECRET=change-me-long-random-string
PUBLIC_URL=http://localhost:3000
REQUIRE_ADMIN_MFA=0

# Payments: mock (default) or stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram (booking notifications, no personal data)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM webhook (HMAC-SHA256 in X-Signature)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Google Sheets (service account must have edit access to the sheet)
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
SHEETS_ID=
SHEETS_RANGE=Bookings!A:I

# E-mail
SMTP_URL=
MAIL_FROM=Stayly <no-reply@example.com>

# REST supplier / PMS (see docs/SUPPLIER_API.md)
SUPPLIER_REST_URL=
SUPPLIER_REST_KEY=
SUPPLIER_SYNC_MIN=30
